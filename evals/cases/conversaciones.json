  {"id": "conv-ssd-por-que", "category": "conversaciones", "turns": [
    {"message": "¿Qué es un SSD?", "expect": {"route": "general"}},
    {"message": "¿Por qué es más rápido?", "expect": {"route": "general", "contains_any": ["mecánic", "partes móviles", "flash", "giratori"]}}]},
  {"id": "conv-mfa-apps", "category": "conversaciones", "turns": [
    {"message": "¿Qué es la autenticación de dos factores?", "expect": {"route": "general"}},
