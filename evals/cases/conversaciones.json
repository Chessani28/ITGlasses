  {"id": "conv-manual-luego-general", "category": "conversaciones", "turns": [
    {"message": "Dame los pasos para reiniciar el servidor", "expect": {"route": "knowledge"}},
    {"message": "¿Qué es un servidor?", "expect": {"route": "general", "contains_any": ["servicio", "red", "computadora", "equipo"]}}]},
  {"id": "conv-gracias-tras-pasos", "category": "conversaciones", "turns": [
    {"message": "Dame los pasos de la guía de instalación", "expect": {"route": "knowledge"}},
    {"message": "Gracias", "expect": {"route": "social"}},
