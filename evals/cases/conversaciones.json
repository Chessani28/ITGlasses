    {"message": "Explícame el paso 3", "expect": {"route": "knowledge", "contains_any": ["credenciales", "usuario", "contraseña"]}},
    {"message": "¿Y el siguiente?", "expect": {"route": "knowledge", "contains_any": ["servidor"]}}]},
  {"id": "conv-reinicio-anterior", "category": "conversaciones", "turns": [
    {"message": "¿Cuáles son los pasos para reiniciar el servidor?", "expect": {"route": "knowledge"}},
    {"message": "Explícame el paso dos", "expect": {"route": "knowledge", "contains_any": ["30 segundos", "esperar"]}},
    {"message": "¿Y el anterior?", "expect": {"route": "knowledge", "contains_any": ["apagar"]}}]},
  {"id": "conv-general-luego-manual", "category": "conversaciones", "turns": [
    {"message": "¿Qué es el DHCP?", "expect": {"route": "general"}},
