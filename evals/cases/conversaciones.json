  {"id": "conv-pronombre-sin-contexto", "category": "conversaciones", "turns": [
    {"message": "¿Cómo configuro eso?", "expect": {"max_chars": 400, "contains_any": ["?"]}}]},
  {"id": "conv-no-funciona-sin-contexto", "category": "conversaciones", "turns": [
    {"message": "No funciona", "expect": {"max_chars": 300, "contains_any": ["?"]}}]},
  {"id": "conv-cambio-tema", "category": "conversaciones", "turns": [
    {"message": "¿Qué es el phishing?", "expect": {"route": "general"}},
